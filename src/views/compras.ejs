<%- include('partials/header') %>
<div class="container">
  <h1>Compras</h1>

  <div class="stack-actions">
    <div class="form-group">
      <label for="lojaId">Loja</label>
      <select id="lojaId" required></select>
    </div>
    <button type="button" class="btn-primary" id="showFormBtn">+ Lançar Compra</button>
  </div>

  <div id="newCompraForm" class="panel" hidden>
    <div class="card">
      <h3>Nova Compra</h3>
      <form class="form" id="compraForm">
        <div class="form-group">
          <label for="insumoId">Insumo</label>
          <select id="insumoId" required></select>
        </div>
        <div class="form-group">
          <label for="qtdEmbalagens">Quantidade (embalagens)</label>
          <input type="number" id="qtdEmbalagens" step="0.001" required>
        </div>
        <div class="form-group">
          <label for="valorTotal">Valor Total (R$)</label>
          <input type="number" id="valorTotal" step="0.01" required>
        </div>
        <div class="form-group">
          <label for="fornecedor">Fornecedor (opcional)</label>
          <input type="text" id="fornecedor">
        </div>
        <div class="form-group">
          <label for="dataCompra">Data da Compra</label>
          <input type="date" id="dataCompra">
        </div>
        <div class="stack-actions">
          <button type="submit" class="btn-primary">Lançar Compra</button>
          <button type="button" class="btn-secondary" id="cancelFormBtn">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="comprasList">
    <p>Carregando...</p>
  </div>

  <script nonce="<%= cspNonce %>">
    const lojaSelect = document.getElementById('lojaId');
    const insumoSelect = document.getElementById('insumoId');
    const form = document.getElementById('newCompraForm');
    const list = document.getElementById('comprasList');

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    async function fillSelect(select, url) {
      const res = await fetch(url);
      if (!res.ok) return [];
      const items = await res.json();
      select.innerHTML = items
        .map((i) => `<option value="${escapeHtml(i.id)}">${escapeHtml(i.nome)}</option>`)
        .join('');
      return items;
    }

    async function loadCompras() {
      const lojaId = lojaSelect.value;
      if (!lojaId) {
        list.innerHTML = '<p>Cadastre uma loja para lançar compras.</p>';
        return;
      }

      const res = await fetch(`/api/compras?lojaId=${encodeURIComponent(lojaId)}`);
      if (!res.ok) {
        list.innerHTML = '<p>Não foi possível carregar as compras.</p>';
        return;
      }
      const compras = await res.json();

      list.innerHTML = compras.length === 0
        ? '<p>Nenhuma compra registrada</p>'
        : `<div class="table-wrap"><table class="table">
            <thead><tr><th>Insumo</th><th class="num">Qtd</th><th class="num">Valor</th><th>Data</th></tr></thead>
            <tbody>${compras.map((c) => `
              <tr>
                <td>${escapeHtml(c.insumo_nome)}</td>
                <td class="num">${c.qtd_embalagens}</td>
                <td class="num">R$ ${parseFloat(c.valor_total).toFixed(2)}</td>
                <td>${new Date(c.data_compra).toLocaleDateString('pt-BR')}</td>
              </tr>`).join('')}
            </tbody></table></div>`;
    }

    function hideForm() {
      form.hidden = true;
      document.getElementById('compraForm').reset();
    }

    document.getElementById('showFormBtn').addEventListener('click', () => {
      form.hidden = false;
      insumoSelect.focus();
    });

    document.getElementById('cancelFormBtn').addEventListener('click', hideForm);

    lojaSelect.addEventListener('change', loadCompras);

    document.getElementById('compraForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/api/compras', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        body: JSON.stringify({
          lojaId: lojaSelect.value,
          insumoId: insumoSelect.value,
          qtdEmbalagens: parseFloat(document.getElementById('qtdEmbalagens').value),
          valorTotal: parseFloat(document.getElementById('valorTotal').value),
          fornecedor: document.getElementById('fornecedor').value,
          dataCompra: document.getElementById('dataCompra').value,
        }),
      });

      if (res.ok) {
        hideForm();
        loadCompras();
      } else {
        const err = await res.json().catch(() => ({}));
        alert('Erro ao lançar compra: ' + (err.error || res.status));
      }
    });

    (async () => {
      await Promise.all([
        fillSelect(lojaSelect, '/api/lojas'),
        fillSelect(insumoSelect, '/api/insumos'),
      ]);
      loadCompras();
    })();
  </script>
</div>
<%- include('partials/footer') %>
