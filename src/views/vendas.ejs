<%- include('partials/header') %>
<div class="container">
  <h1>Vendas do Período</h1>

  <div class="stack-actions">
    <div class="form-group">
      <label for="lojaId">Loja</label>
      <select id="lojaId" required></select>
    </div>
    <button type="button" class="btn-primary" id="showFormBtn">+ Registrar Venda</button>
  </div>

  <div id="newVendaForm" class="panel" hidden>
    <div class="card">
      <h3>Registrar Venda do Período</h3>
      <form class="form" id="vendaForm">
        <div class="form-group">
          <label for="dataInicio">Data Início</label>
          <input type="date" id="dataInicio" required>
        </div>
        <div class="form-group">
          <label for="dataFim">Data Fim</label>
          <input type="date" id="dataFim" required>
        </div>
        <div class="form-group">
          <label for="faturamento">Faturamento (R$)</label>
          <input type="number" id="faturamento" step="0.01" required>
        </div>
        <div class="stack-actions">
          <button type="submit" class="btn-primary">Registrar Venda</button>
          <button type="button" class="btn-secondary" id="cancelFormBtn">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="vendasList">
    <p>Carregando...</p>
  </div>

  <script type="module" nonce="<%= cspNonce %>">
    import { formatDateOnly } from '/js/date-only.js';

    const lojaSelect = document.getElementById('lojaId');
    const form = document.getElementById('newVendaForm');
    const list = document.getElementById('vendasList');

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    async function loadLojas() {
      const res = await fetch('/api/lojas');
      if (!res.ok) return;
      const lojas = await res.json();
      lojaSelect.innerHTML = lojas
        .map((l) => `<option value="${escapeHtml(l.id)}">${escapeHtml(l.nome)}</option>`)
        .join('');
    }

    async function loadVendas() {
      const lojaId = lojaSelect.value;
      if (!lojaId) {
        list.innerHTML = '<p>Cadastre uma loja para registrar vendas.</p>';
        return;
      }

      const res = await fetch(`/api/vendas?lojaId=${encodeURIComponent(lojaId)}`);
      if (!res.ok) {
        list.innerHTML = '<p>Não foi possível carregar as vendas.</p>';
        return;
      }
      const vendas = await res.json();

      list.innerHTML = vendas.length === 0
        ? '<p>Nenhuma venda registrada</p>'
        : `<div class="table-wrap"><table class="table">
            <thead><tr><th>Período</th><th class="num">Faturamento</th></tr></thead>
            <tbody>${vendas.map((v) => `
              <tr>
                <td>${formatDateOnly(v.data_inicio)} — ${formatDateOnly(v.data_fim)}</td>
                <td class="num">R$ ${parseFloat(v.faturamento).toFixed(2)}</td>
              </tr>`).join('')}
            </tbody></table></div>`;
    }

    function hideForm() {
      form.hidden = true;
      document.getElementById('vendaForm').reset();
    }

    document.getElementById('showFormBtn').addEventListener('click', () => {
      form.hidden = false;
      document.getElementById('dataInicio').focus();
    });

    document.getElementById('cancelFormBtn').addEventListener('click', hideForm);

    lojaSelect.addEventListener('change', loadVendas);

    document.getElementById('vendaForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/api/vendas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        body: JSON.stringify({
          lojaId: lojaSelect.value,
          dataInicio: document.getElementById('dataInicio').value,
          dataFim: document.getElementById('dataFim').value,
          faturamento: parseFloat(document.getElementById('faturamento').value),
        }),
      });

      if (res.ok) {
        hideForm();
        loadVendas();
      } else {
        const err = await res.json().catch(() => ({}));
        alert('Erro: ' + (err.error || res.status));
      }
    });

    (async () => {
      await loadLojas();
      loadVendas();
    })();
  </script>
</div>
<%- include('partials/footer') %>
