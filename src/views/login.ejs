<%- include('partials/header') %>
<div class="auth-container">
  <div class="auth-card">
    <h1>Entrar</h1>

    <form method="post" action="/auth/login" class="form">
      <div class="form-group">
        <label for="email">Usuário ou email</label>
        <input type="text" id="email" name="email" autocomplete="username" required>
      </div>

      <div class="form-group">
        <label for="password">Senha</label>
        <input type="password" id="password" name="senha" required>
      </div>

      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <button type="submit" class="btn-primary btn-block">Entrar</button>
    </form>

    <p class="auth-link">Não tem conta? <a href="/register">Criar agora</a></p>
  </div>
</div>
<%- include('partials/footer') %>
