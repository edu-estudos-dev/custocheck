<%- include('partials/header') %>
<div class="container">
  <h1>Contagem de Estoque</h1>
  <p class="meta page-lead">Registre quanto sobrou fisicamente de cada insumo. É o que fecha a conta do CMV real.</p>

  <div class="stack-actions">
    <div class="form-group">
      <label for="lojaId">Loja</label>
      <select id="lojaId" required></select>
    </div>
    <button type="button" class="btn-primary" id="showFormBtn">+ Nova Contagem</button>
  </div>

  <div id="newContagemForm" class="panel" hidden>
    <div class="card">
      <h3 id="formTitle">Nova Contagem</h3>
      <form class="form" id="contagemForm">
        <div class="form-group">
          <label for="dataReferencia">Data da Contagem</label>
          <input type="date" id="dataReferencia" required>
        </div>

        <div id="itensContagem"></div>

        <div class="stack-actions">
          <button type="submit" class="btn-primary" id="submitBtn">Salvar Contagem</button>
          <button type="button" class="btn-secondary" id="deleteBtn" hidden>Excluir</button>
          <button type="button" class="btn-secondary" id="cancelFormBtn">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="contagensList">
    <p>Carregando...</p>
  </div>

  <script type="module" nonce="<%= cspNonce %>">
    import { formatDateOnly } from '/js/date-only.js';

    const lojaSelect = document.getElementById('lojaId');
    const form = document.getElementById('newContagemForm');
    const formTitle = document.getElementById('formTitle');
    const submitBtn = document.getElementById('submitBtn');
    const deleteBtn = document.getElementById('deleteBtn');
    const itensContainer = document.getElementById('itensContagem');
    const list = document.getElementById('contagensList');
    let insumos = [];
    let editingId = null;

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    async function fillSelect(select, url) {
      const res = await fetch(url);
      if (!res.ok) return [];
      const items = await res.json();
      select.innerHTML = items
        .map((i) => `<option value="${escapeHtml(i.id)}">${escapeHtml(i.nome)}</option>`)
        .join('');
      return items;
    }

    function renderItensContagem(valores = {}) {
      if (insumos.length === 0) {
        itensContainer.innerHTML = '<p class="meta">Cadastre insumos antes de fazer uma contagem.</p>';
        return;
      }
      itensContainer.innerHTML = insumos.map((i) => `
        <div class="form-group">
          <label for="item-${i.id}">${escapeHtml(i.nome)} (${escapeHtml(i.unidade_base)})</label>
          <input type="number" step="0.001" min="0" id="item-${i.id}" data-insumo-id="${i.id}"
                 value="${valores[i.id] ?? ''}" placeholder="0" required>
        </div>
      `).join('');
    }

    async function loadContagens() {
      const lojaId = lojaSelect.value;
      if (!lojaId) {
        list.innerHTML = '<p>Cadastre uma loja para fazer contagens.</p>';
        return;
      }

      const res = await fetch(`/api/contagens?lojaId=${encodeURIComponent(lojaId)}`);
      if (!res.ok) {
        list.innerHTML = '<p>Não foi possível carregar as contagens.</p>';
        return;
      }
      const contagens = await res.json();

      list.innerHTML = contagens.length === 0
        ? '<p>Nenhuma contagem registrada</p>'
        : `<div class="table-wrap"><table class="table">
            <thead><tr><th>Data</th><th>Status</th><th></th></tr></thead>
            <tbody>${contagens.map((c) => `
              <tr>
                <td>${formatDateOnly(c.data_referencia)}</td>
                <td>${escapeHtml(c.status)}</td>
                <td class="num"><button type="button" class="btn-secondary btn-edit-contagem" data-id="${c.id}">Editar</button></td>
              </tr>`).join('')}
            </tbody></table></div>`;

      list.querySelectorAll('.btn-edit-contagem').forEach((btn) => {
        btn.addEventListener('click', () => openEditForm(btn.dataset.id));
      });
    }

    function showForm() {
      form.hidden = false;
    }

    function hideForm() {
      form.hidden = true;
      document.getElementById('contagemForm').reset();
      editingId = null;
      formTitle.textContent = 'Nova Contagem';
      submitBtn.textContent = 'Salvar Contagem';
      deleteBtn.hidden = true;
      renderItensContagem();
    }

    async function openEditForm(id) {
      const res = await fetch(`/api/contagens/${id}`);
      if (!res.ok) {
        alert('Não foi possível carregar essa contagem');
        return;
      }
      const contagem = await res.json();

      editingId = id;
      formTitle.textContent = 'Editar Contagem';
      submitBtn.textContent = 'Atualizar Contagem';
      deleteBtn.hidden = false;

      document.getElementById('dataReferencia').value = contagem.data_referencia.slice(0, 10);
      const valores = Object.fromEntries(contagem.itens.map((i) => [i.insumo_id, i.qtd_base]));
      renderItensContagem(valores);

      showForm();
    }

    document.getElementById('showFormBtn').addEventListener('click', () => {
      hideForm();
      showForm();
      document.getElementById('dataReferencia').focus();
    });

    document.getElementById('cancelFormBtn').addEventListener('click', hideForm);

    deleteBtn.addEventListener('click', async () => {
      if (!editingId || !confirm('Excluir esta contagem?')) return;

      const res = await fetch(`/api/contagens/${editingId}`, {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': window.csrfToken },
      });

      if (res.ok) {
        hideForm();
        loadContagens();
      } else {
        const err = await res.json().catch(() => ({}));
        alert('Erro ao excluir: ' + (err.error || res.status));
      }
    });

    lojaSelect.addEventListener('change', loadContagens);

    document.getElementById('contagemForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const itens = insumos.map((i) => ({
        insumoId: i.id,
        qtdBase: document.getElementById(`item-${i.id}`).value,
      }));

      const url = editingId ? `/api/contagens/${editingId}` : '/api/contagens';
      const method = editingId ? 'PUT' : 'POST';
      const body = editingId
        ? { dataReferencia: document.getElementById('dataReferencia').value, itens }
        : { lojaId: lojaSelect.value, dataReferencia: document.getElementById('dataReferencia').value, itens };

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        hideForm();
        loadContagens();
      } else {
        const err = await res.json().catch(() => ({}));
        alert('Erro ao salvar contagem: ' + (err.error || res.status));
      }
    });

    (async () => {
      await fillSelect(lojaSelect, '/api/lojas');
      const res = await fetch('/api/insumos');
      insumos = res.ok ? await res.json() : [];
      renderItensContagem();
      loadContagens();
    })();
  </script>
</div>
<%- include('partials/footer') %>
