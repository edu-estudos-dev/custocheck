<%- include('partials/header') %>
<div class="container">
  <h1>Minhas Lojas</h1>

  <div class="stack-actions">
    <button type="button" class="btn-primary" id="showFormBtn">+ Adicionar Loja</button>
  </div>

  <div id="newLojaForm" class="panel" hidden>
    <div class="card">
      <h3>Nova Loja</h3>
      <form class="form" id="lojaForm">
        <div class="form-group">
          <label for="nomeLoja">Nome</label>
          <input type="text" id="nomeLoja" required>
        </div>
        <div class="form-group">
          <label for="cidadeLoja">Cidade</label>
          <input type="text" id="cidadeLoja">
        </div>
        <div class="stack-actions">
          <button type="submit" class="btn-primary">Criar Loja</button>
          <button type="button" class="btn-secondary" id="cancelFormBtn">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="lojasList">
    <p>Carregando...</p>
  </div>

  <script nonce="<%= cspNonce %>">
    const form = document.getElementById('newLojaForm');
    const list = document.getElementById('lojasList');

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    async function loadLojas() {
      const res = await fetch('/api/lojas');
      if (!res.ok) {
        list.innerHTML = '<p>Não foi possível carregar as lojas.</p>';
        return;
      }
      const lojas = await res.json();

      list.innerHTML = lojas.length === 0
        ? '<p>Nenhuma loja cadastrada</p>'
        : '<div class="grid">' + lojas.map(l => `
          <div class="card">
            <h3>${escapeHtml(l.nome)}</h3>
            <p>${escapeHtml(l.cidade) || 'Sem cidade'}</p>
            <p class="meta">Criado em ${new Date(l.criado_em).toLocaleDateString('pt-BR')}</p>
          </div>
        `).join('') + '</div>';
    }

    function hideForm() {
      form.hidden = true;
      document.getElementById('nomeLoja').value = '';
      document.getElementById('cidadeLoja').value = '';
    }

    document.getElementById('showFormBtn').addEventListener('click', () => {
      form.hidden = false;
      document.getElementById('nomeLoja').focus();
    });

    document.getElementById('cancelFormBtn').addEventListener('click', hideForm);

    document.getElementById('lojaForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/api/lojas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        body: JSON.stringify({
          nome: document.getElementById('nomeLoja').value,
          cidade: document.getElementById('cidadeLoja').value,
        }),
      });

      if (res.ok) {
        hideForm();
        loadLojas();
      } else {
        alert('Erro ao criar loja');
      }
    });

    loadLojas();
  </script>
</div>
<%- include('partials/footer') %>
