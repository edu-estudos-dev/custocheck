<div class="container">
  <h1>Minhas Lojas</h1>

  <div style="margin-bottom: 2rem;">
    <button class="btn-primary" onclick="showNewLojaForm()">+ Adicionar Loja</button>
  </div>

  <div id="newLojaForm" style="display: none; margin-bottom: 2rem;">
    <div class="card">
      <h3>Nova Loja</h3>
      <form class="form" onsubmit="createLoja(event)">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" id="nomeLoja" required>
        </div>
        <div class="form-group">
          <label>Cidade</label>
          <input type="text" id="cidadeLoja">
        </div>
        <button type="submit" class="btn-primary">Criar Loja</button>
        <button type="button" class="btn-secondary" onclick="hideNewLojaForm()">Cancelar</button>
      </form>
    </div>
  </div>

  <div id="lojasList" style="display: none;">
    <p>Carregando...</p>
  </div>

  <script nonce="<%= cspNonce %>">
    window.csrfToken = '<%= safeJson(csrfToken) %>';

    async function loadLojas() {
      const res = await fetch('/api/lojas');
      const lojas = await res.json();

      const html = lojas.length === 0
        ? '<p>Nenhuma loja cadastrada</p>'
        : '<div class="grid">' + lojas.map(l => `
          <div class="card">
            <h3>${escapeHtml(l.nome)}</h3>
            <p>${l.cidade || 'Sem cidade'}</p>
            <p style="color: var(--ink-soft); font-size: var(--text-sm);">Criado em ${new Date(l.criado_em).toLocaleDateString('pt-BR')}</p>
          </div>
        `).join('') + '</div>';

      document.getElementById('lojasList').innerHTML = html;
      document.getElementById('lojasList').style.display = 'block';
    }

    async function createLoja(e) {
      e.preventDefault();
      const nome = document.getElementById('nomeLoja').value;
      const cidade = document.getElementById('cidadeLoja').value;

      const res = await fetch('/api/lojas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        body: JSON.stringify({ nome, cidade }),
      });

      if (res.ok) {
        hideNewLojaForm();
        loadLojas();
      } else {
        alert('Erro ao criar loja');
      }
    }

    function showNewLojaForm() {
      document.getElementById('newLojaForm').style.display = 'block';
    }

    function hideNewLojaForm() {
      document.getElementById('newLojaForm').style.display = 'none';
      document.getElementById('nomeLoja').value = '';
      document.getElementById('cidadeLoja').value = '';
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    loadLojas();
  </script>
</div>
