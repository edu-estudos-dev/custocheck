<div class="auth-container">
  <div class="auth-card">
    <h1>Criar Conta</h1>

    <form method="post" action="/auth/signup" class="form">
      <div class="form-group">
        <label for="name">Seu Nome</label>
        <input type="text" id="name" name="nome" required>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="password">Senha (min 8 chars, 1 MAIÚSCULA, 1 minúscula, 1 número)</label>
        <input type="password" id="password" name="senha" required>
      </div>

      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <button type="submit" class="btn-primary btn-block">Criar Conta</button>
    </form>

    <p class="auth-link">Já tem conta? <a href="/login">Entrar</a></p>
  </div>
</div>
