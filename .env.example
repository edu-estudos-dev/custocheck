# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/custocheck
DB_SSL=false
DATABASE_POOL_MAX=6
DATABASE_IDLE_TIMEOUT_MS=60000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Role custocheck_app (sem privilégio de dono/superusuário — RLS de verdade
# se aplica a ela). Rode `migrate:apply` pra criar a role, defina uma senha
# com ALTER ROLE custocheck_app WITH PASSWORD '...' e aponte aqui. Deixe em
# branco pra manter o comportamento atual (RLS inerte, filtro só na app).
DATABASE_APP_URL=

# Session
SESSION_SECRET=generate-a-32-char-random-string-here-at-least-32-chars
REDIS_URL=

# App
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# Observability
SENTRY_DSN=

# Timezone
TZ=America/Fortaleza
